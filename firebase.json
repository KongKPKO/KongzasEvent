{
  "hosting": {
    "target": "nireqapp",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "regex": "^/for-sellers/?$",
        "destination": "/seller-landing.html"
      },
      {
        "destination": "/index.html",
        "regex": "^/(?:|discover(?:/shops)?|offline|manage-login|manage-workspaces|for-sellers|creator/register|staff-signup|reset-password|help(?:/guide)?|privacy|terms|cookies|admin(?:/.*)?|invitations|manage-products|manage-promotions|manage-order-problems|manage-events(?:/[^/]+(?:/(?:workspace|history|dashboard|catalog|promotion|preorder|preorder-dashboard|postorder-dashboard|pickup))?)?|manage-profile|manage-online-sales(?:/[^/]+)?|manage-team|manage-pos-queues|live(?:/(?:queue|pos))?|[^/]+(?:/(?:home|menu|queue|campaign/[^/]+|order/[^/]+))?)/?$"
      }
    ]
  }
}
